---
/* Every campaign template as a card: what people comment, and what they
   get back. Sign-in is team-only, so cards point to the repo. Same source
   as the app. */
import { CAMPAIGN_TEMPLATES } from "../../../lib/templates/campaign-templates";
import { GITHUB_URL } from "../lib/links";
---
<ul data-reveal class="-mx-[var(--gutter)] flex snap-x snap-mandatory gap-3 overflow-x-auto px-[var(--gutter)] pb-2 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 lg:grid-cols-4">
  {CAMPAIGN_TEMPLATES.map((t) => (
    <li class="w-[16.5rem] shrink-0 snap-start sm:w-auto">
      <a href={GITHUB_URL} class="card glow group flex h-full flex-col p-5 transition-transform duration-300 active:scale-[0.98]">
        <p class="t-label">{t.category}</p>
        <h3 class="mt-1.5 text-[1rem] font-semibold leading-5 tracking-[-0.01em]">{t.title}</h3>
        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Keywords">
          {t.keywords.map((k) => <li class="chip chip-accent">{k}</li>)}
        </ul>
        <p class="mt-4 rounded-xl rounded-br-sm bg-gradient-to-br from-[#b41bef]/90 to-[#8a0fc0]/90 px-3 py-2 text-[0.8125rem] leading-5 text-white line-clamp-3">
          {t.privateReplyPreview}
        </p>
        <span class="mt-auto inline-flex items-center gap-1 pt-5 text-[0.8125rem] font-semibold text-accent-text">
          Get it on GitHub
          <svg viewBox="0 0 12 12" class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5" /></svg>
        </span>
      </a>
    </li>
  ))}
</ul>
