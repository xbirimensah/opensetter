# App
# The example secrets below are refused in production (lib/startup-checks.ts).
# Generate real ones: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
# Required for the cron routes (token refresh etc.); they refuse to run without it.
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Key rotation: old keys here (comma-separated) keep decrypting until
# scripts/rotate-encryption-key.ts has re-encrypted everything.
# ENCRYPTION_KEYS_PREVIOUS=
# Full /api/health details for callers sending this as x-health-token
# (requests from the server itself always get them).
# HEALTH_TOKEN=

# Alerts (all optional, any mix; lib/ops/alerts.ts). A failing health
# check, worker job failures and token refresh errors are pushed here.
# ALERT_NTFY_URL=https://ntfy.sh/your-private-topic
# ALERT_NTFY_TOKEN=
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Slack-style incoming webhook (JSON {"text": ...}).
# ALERT_WEBHOOK_URL=
# Email through Resend (uses RESEND_API_KEY below).
# ALERT_EMAIL_TO=you@example.com
# Repeats of one alert within this window are dropped (seconds, default 3600).
# ALERT_DEDUPE_SECONDS=3600
# Health check interval for alerts (ms, default 120000); "off" disables it.
# ALERT_HEALTH_INTERVAL_MS=120000
# ALERT_HEALTH_WATCH=off

# Backups (scripts/backup.sh, `npm run backup`)
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# For a database in Docker without pg_dump on the host:
# PG_DUMP_CMD=docker exec opensetter-db pg_dump -U postgres opensetter

# Access
# Who may get an email sign-in link besides existing users and invitees.
# OPENSETTER_ALLOWED_EMAILS=you@example.com
# Required in production: the instance operator(s). Only their workspaces may
# use the server's CLI login, the env API key and the knowledge base, and
# on a fresh install only they can create the first account.
OPENSETTER_OPERATOR_EMAILS=you@example.com

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opensetter
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenSetter <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# AI setter (all optional; the setter stays off without them)
# Provider: anthropic | openai | claude-cli | codex-cli
AI_SETTER_PROVIDER=anthropic
AI_SETTER_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_SETTER_API_KEY=
# AI_SETTER_BASE_URL=https://api.openai.com/v1
# Local Claude Code / Codex CLIs are selectable per account in the Models tab
# (no API key; uses the server user's CLI login). Paths if not on PATH:
# AI_SETTER_CLAUDE_BIN=/opt/homebrew/bin/claude
# AI_SETTER_CODEX_BIN=/opt/homebrew/bin/codex
# Set to off when workspaces must not share this server's CLI subscription.
# AI_SETTER_CLI_PROVIDERS=off
# Codex CLI can read files on this server, so it stays off unless set to on.
# AI_SETTER_CODEX_CLI=on
# Encrypts model-provider keys saved in the AI Setter UI (Models tab).
# 32-byte hex, `openssl rand -hex 32`. Without it, saving keys in the UI
# is disabled and the env provider above is used. Same value on web + worker.
AI_CREDENTIALS_ENCRYPTION_KEY=
# Allow UI-configured base URLs on private/local addresses (self-hosted models).
# AI_PROVIDER_ALLOW_PRIVATE_BASE_URL=true

# Knowledge base (optional, docs/ai-setter.md). Without Supabase env the
# setter uses a local SQLite file built by: npm run knowledge:ingest
SECOND_BRAIN_SUPABASE_URL=
SECOND_BRAIN_SUPABASE_SERVICE_ROLE_KEY=
# SECOND_BRAIN_SQLITE_PATH=./data/knowledge.db
# SECOND_BRAIN_HYBRID_SEARCH_RPC=opensetter_hybrid_search
# SECOND_BRAIN_STYLE_SEARCH_RPC=opensetter_style_search
# SECOND_BRAIN_DOCUMENTS_TABLE=opensetter_documents
# SECOND_BRAIN_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# AI_SETTER_EMBEDDINGS=off
# A self-hosted second-brain API instead of Supabase (rollback: unset the backend var).
# SECOND_BRAIN_BACKEND=brain-api
# BRAIN_API_URL=http://127.0.0.1:8790   (loopback http or https only)
# BRAIN_API_TOKEN=
# Read-only search token; file must be chmod 600 or it is refused.
# BRAIN_API_TOKEN_FILE=~/.config/opensetter/brain-api-token
# BRAIN_API_SEARCH_FOLDERS=Knowledge,Areas

# ─── Flows and media ───────────────────────────────────────────────────────
# Where uploaded flow media (sent to Instagram by public URL) and copies of
# inbound voice notes, photos and videos are stored. Default ./data/media.
# NEXTAUTH_URL must be the public https URL so Meta can fetch uploads.
# MEDIA_DIR=./data/media
# How often the worker expires timed-out flow waits and re-arms delays (ms).
# FLOW_SWEEP_INTERVAL_MS=60000
