# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenSetter <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# AI setter (all optional; the setter stays off without them)
# Provider: anthropic | openai | claude-cli | codex-cli
AI_SETTER_PROVIDER=anthropic
AI_SETTER_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_SETTER_API_KEY=
# AI_SETTER_BASE_URL=https://api.openai.com/v1
# Local Claude Code / Codex CLIs are selectable per account in the Models tab
# (no API key; uses the server user's CLI login). Paths if not on PATH:
# AI_SETTER_CLAUDE_BIN=/opt/homebrew/bin/claude
# AI_SETTER_CODEX_BIN=/opt/homebrew/bin/codex
# Set to off when workspaces must not share this server's CLI subscription.
# AI_SETTER_CLI_PROVIDERS=off
# Encrypts model-provider keys saved in the AI Setter UI (Models tab).
# 32-byte hex, `openssl rand -hex 32`. Without it, saving keys in the UI
# is disabled and the env provider above is used. Same value on web + worker.
AI_CREDENTIALS_ENCRYPTION_KEY=
# Allow UI-configured base URLs on private/local addresses (self-hosted models).
# AI_PROVIDER_ALLOW_PRIVATE_BASE_URL=true

# Knowledge base (optional, docs/ai-setter.md). Without Supabase env the
# setter uses a local SQLite file built by: npm run knowledge:ingest
SECOND_BRAIN_SUPABASE_URL=
SECOND_BRAIN_SUPABASE_SERVICE_ROLE_KEY=
# SECOND_BRAIN_SQLITE_PATH=./data/knowledge.db
# SECOND_BRAIN_HYBRID_SEARCH_RPC=opensetter_hybrid_search
# SECOND_BRAIN_STYLE_SEARCH_RPC=opensetter_style_search
# SECOND_BRAIN_DOCUMENTS_TABLE=opensetter_documents
# SECOND_BRAIN_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# AI_SETTER_EMBEDDINGS=off
# A self-hosted second-brain API instead of Supabase (rollback: unset the backend var).
# SECOND_BRAIN_BACKEND=brain-api
# BRAIN_API_URL=http://127.0.0.1:8790   (loopback http or https only)
# BRAIN_API_TOKEN=
# Read-only search token; file must be chmod 600 or it is refused.
# BRAIN_API_TOKEN_FILE=~/.config/opensetter/brain-api-token
# BRAIN_API_SEARCH_FOLDERS=Knowledge,Areas
