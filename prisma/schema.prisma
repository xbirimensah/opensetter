// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// scrypt hash for email + password login (lib/password.ts). Null until
  /// the user sets a password in Settings; email links work either way.
  passwordHash      String?
  /// Sessions signed in before this moment end (lib/auth.ts jwt callback).
  passwordUpdatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members               WorkspaceMember[]
  invitations           WorkspaceInvitation[]
  instagramAccounts     InstagramAccount[]
  automations           Automation[]
  dmLogs                DmLog[]
  trackedLinks          TrackedLink[]
  linkClicks            LinkClick[]
  webhookEvents         WebhookEvent[]
  operationalEvents     OperationalEvent[]
  aiProviderCredentials AiProviderCredential[]
  flows                 Flow[]
  mediaAssets           MediaAsset[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  instagramId       String    @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean   @default(false)
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations        Automation[]
  dmLogs             DmLog[]
  linkClicks         LinkClick[]
  followerSnapshots  FollowerSnapshot[]
  aiSetterConfig     AiSetterConfig?
  dmConversations    DmConversation[]
  aiReplyLogs        AiReplyLog[]
  styleCorpusEntries StyleCorpusEntry[]
  voiceCorrections   VoiceCorrection[]
  flows              Flow[]

  @@index([workspaceId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                    String
  goal                    String?
  postId                  String?
  postUrl                 String?
  pendingNextReel         Boolean  @default(false)
  matchAnyPost            Boolean  @default(false)
  keywords                String[]
  matchAnyWord            Boolean  @default(false)
  dmMessage               String
  openingDmEnabled        Boolean  @default(false)
  openingDmMessage        String?
  openingDmButtonLabel    String?
  linkButtonLabel         String?
  requireFollow           Boolean  @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled         Boolean  @default(false)
  followUpMessage         String?
  publicReplyEnabled      Boolean  @default(false)
  publicReplyMessage      String?
  publicReplyMessages     String[] @default([])
  isActive                Boolean  @default(true)
  wholeWordMatch          Boolean  @default(true)
  /// Rewrite the opening DM text per commenter with the AI setter's
  /// persona, referencing their actual comment. Falls back to the static
  /// text on any model failure.
  aiPersonalizeDm         Boolean  @default(false)
  /// When set, a matching comment starts this flow (ManyChat-style) instead
  /// of the legacy opening DM / reveal pipeline.
  flowId                  String?
  flow                    Flow?    @relation(fields: [flowId], references: [id], onDelete: SetNull)
  reportShareSlug         String?  @unique
  reportShareEnabled      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
  @@index([flowId])
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  commentText    String
  commentId      String
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

/// Per-account settings for the AI DM setter. One row per Instagram account;
/// absence of a row means the setter is off with defaults.
model AiSetterConfig {
  id                 String       @id @default(cuid())
  instagramAccountId String       @unique
  mode               AiSetterMode @default(OFF)

  /// Who the account is: business, offer, audience — grounds every reply.
  persona     String?
  /// What the setter is driving toward (qualify, book a call, ...).
  goal        String?
  /// Link handed out when the conversation earns it (cal.com etc.).
  bookingLink String?
  /// Force a reply language; null lets the model match the incoming message.
  language    String?

  /// Pull facts from the connected second-brain knowledge base.
  knowledgeEnabled     Boolean @default(true)
  /// Pull texting-style examples from the isolated style index.
  styleExamplesEnabled Boolean @default(true)

  /// Below this model confidence a draft is held for review instead of sent.
  minConfidence      Float    @default(0.78)
  /// Wait before drafting so rapid-fire messages collapse into one reply.
  replyDelaySeconds  Int      @default(10)
  /// When the account owner replies manually, pause the AI for that thread.
  pauseOnHumanReply  Boolean  @default(true)
  /// Nudge a prospect who went quiet before the 24h messaging window
  /// closes. Draft mode holds the nudge for review like any reply.
  windowNudgeEnabled Boolean  @default(false)
  /// Hours after the prospect's last message before the nudge fires.
  windowNudgeHours   Int      @default(20)
  /// IGSIDs the setter must never reply to.
  blockedUserIds     String[] @default([])
  /// Domains an auto-sent draft may link to besides the booking link's
  /// host; any other link holds the draft (lib/ai-setter/link-guard.ts).
  allowedLinkDomains String[] @default([])

  /// Sprachprofil: the owner's editable voice rules. Null uses the
  /// built-in style guide.
  voiceRules          String?
  /// Retrieve examples from the local style corpus (own human-typed DMs).
  styleCorpusEnabled  Boolean   @default(true)
  /// Auto-send only in threads where the owner has typed at least one
  /// message by hand (the WhatsApp sidecar's strict voice rule).
  strictVoiceEvidence Boolean   @default(false)
  /// When the style corpus was last rebuilt from mirrored DMs.
  styleCorpusBuiltAt  DateTime?
  /// Model provider chosen in the UI; null keeps the env-based provider.
  llmProvider         String?
  /// Model id for llmProvider; null uses the provider's saved default.
  llmModel            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
}

/// One DM thread between a connected account and an Instagram user. Local
/// mirror of the conversation so the setter has more history than Meta's
/// 20-message API window, plus per-thread AI state.
model DmConversation {
  id                  String  @id @default(cuid())
  instagramAccountId  String
  /// IGSID of the other participant.
  participantId       String
  participantUsername String?

  /// Per-thread kill switch for the AI setter.
  aiEnabled       Boolean       @default(true)
  /// Per-thread mode override; null inherits the account's mode. Lets one
  /// thread run on autopilot while another holds drafts for review.
  modeOverride    AiSetterMode?
  /// Set when a human reply is detected and pauseOnHumanReply is on.
  humanTakeoverAt DateTime?
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  /// When the last quiet-prospect nudge was sent (one per 24h window).
  lastNudgeAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instagramAccount   InstagramAccount   @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  messages           DmMessage[]
  aiReplies          AiReplyLog[]
  voiceCorrections   VoiceCorrection[]
  styleCorpusEntries StyleCorpusEntry[]
  flowRuns           FlowRun[]

  /// Contact profile, filled by flow input steps and actions.
  email           String?
  emailCapturedAt DateTime?
  phone           String?
  phoneCapturedAt DateTime?
  tags            String[]  @default([])
  /// Custom contact fields set by flows: { [name]: string | number | boolean }.
  customFields    Json      @default("{}")

  @@unique([instagramAccountId, participantId])
  @@index([instagramAccountId, lastInboundAt])
}

model DmMessage {
  id             String             @id @default(cuid())
  conversationId String
  /// Meta message id — the idempotency key for webhook redelivery.
  mid            String             @unique
  direction      DmMessageDirection
  source         DmMessageSource    @default(PARTICIPANT)
  /// Readable text. For media or cards this is a summary such as
  /// "[Voice message]" so history, search and the AI see something useful.
  text           String
  /// text | image | video | audio | file | card | share | reel | post |
  /// story_reply | story_mention | postback | quick_reply | sticker |
  /// ephemeral | unsupported | deleted
  kind           String             @default("text")
  /// Normalized attachments (see lib/meta/attachments.ts).
  attachments    Json?
  /// mid of the message this one replies to (swipe-reply), if any.
  replyToMid     String?
  /// Reaction emoji the participant left on this message, if any.
  reaction       String?
  /// Set when Meta reports the participant edited or deleted the message.
  editedAt       DateTime?
  deletedAt      DateTime?
  /// Meta event timestamp (webhook delivery order is not guaranteed).
  sentAt         DateTime
  createdAt      DateTime           @default(now())

  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
}

/// Private style corpus: the owner's own human-typed outbound Instagram
/// DMs, derived only from the local mirror. Never AI, campaign, or
/// participant text; contact details are redacted at build time.
model StyleCorpusEntry {
  id                 String   @id @default(cuid())
  instagramAccountId String
  conversationId     String
  /// DmMessage.id this entry was derived from.
  sourceMessageId    String   @unique
  /// Redacted human-typed outbound text. Prospect messages are never
  /// stored here: examples are shared across contacts.
  text               String
  /// de | en | pt | unknown
  language           String
  sentAt             DateTime
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  conversation     DmConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, language, sentAt])
}

/// Contact-scoped voice feedback: applies only to the conversation it
/// was recorded for, never as a global training signal.
model VoiceCorrection {
  id                 String              @id @default(cuid())
  instagramAccountId String
  conversationId     String
  /// Set when the correction came from editing a held draft.
  replyLogId         String?             @unique
  kind               VoiceCorrectionKind
  avoidText          String?
  preferText         String?
  note               String?
  createdAt          DateTime            @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  conversation     DmConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([instagramAccountId, createdAt])
}

/// Model-provider API keys, encrypted at rest (AES-256-GCM, key from
/// AI_CREDENTIALS_ENCRYPTION_KEY, bound to workspace + provider). The
/// plaintext key is never returned to the browser.
model AiProviderCredential {
  id              String   @id @default(cuid())
  workspaceId     String
  /// anthropic | openai | gemini | xai | openrouter | openai-compatible
  provider        String
  encryptedKey    String
  /// Truncated SHA-256 of the key so the owner can tell keys apart.
  keyFingerprint  String
  baseUrl         String?
  defaultModel    String?
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
}

/// Every AI draft the setter produced, whether it was sent, held for review,
/// or skipped — the audit trail behind the dashboard activity feed.
model AiReplyLog {
  id                 String @id @default(cuid())
  conversationId     String
  instagramAccountId String

  /// mid of the inbound message this draft answers — dedup across retries.
  inboundMid  String   @unique
  inboundText String
  draftText   String
  confidence  Float
  shouldSend  Boolean
  needsReview Boolean
  reasons     String[] @default([])

  status       AiReplyStatus @default(PENDING)
  sentMid      String?
  sentAt       DateTime?
  /// True when a human edited the draft before approving. The edit is
  /// stored as a contact-scoped VoiceCorrection (draft vs. final text).
  humanEdited  Boolean       @default(false)
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation     DmConversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@index([instagramAccountId, createdAt])
  @@index([status])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
  /// Security-relevant actions (lib/audit.ts): sign-ins, passwords, roles,
  /// account connections, provider keys.
  AUDIT
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

enum AiSetterMode {
  OFF
  /// Draft replies but hold every one for human approval.
  DRAFT
  /// Send automatically when safety gates pass; hold otherwise.
  AUTO
}

enum DmMessageDirection {
  IN
  OUT
}

enum DmMessageSource {
  /// Inbound from the Instagram user.
  PARTICIPANT
  /// Outbound typed by a human (dashboard or IG app echo).
  HUMAN
  /// Outbound sent by the AI setter.
  AI
  /// Outbound sent by a comment-to-DM campaign.
  CAMPAIGN
  /// Outbound sent by a flow step.
  FLOW
}

enum VoiceCorrectionKind {
  /// The owner edited a held draft before approving it.
  EDIT
  /// Added by hand in the Sprachprofil.
  MANUAL
}

enum AiReplyStatus {
  PENDING
  /// Claimed for delivery; the Meta send call is in flight. A crash here
  /// leaves the row SENDING, and recovery quarantines it as HELD instead
  /// of ever resending automatically.
  SENDING
  SENT
  /// Held for human review (draft mode, low confidence, or safety gate).
  HELD
  SKIPPED
  FAILED
  DISMISSED
}

// ─── Flows (ManyChat-style automations) ───────────────────────────────────────

/// A flow is a graph of steps (send message, collect input, condition,
/// action, delay, randomizer, AI handoff). Comment triggers live on
/// Automation.flowId; every other trigger lives in `triggers`.
model Flow {
  id                 String     @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  name               String
  status             FlowStatus @default(DRAFT)
  /// FlowTrigger[] (see lib/flows/types.ts): dm_keyword, story_reply,
  /// story_mention, ref_link, welcome, new_follower.
  triggers           Json       @default("[]")
  /// FlowGraph: { startNodeId, nodes }.
  graph              Json
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  automations      Automation[]
  runs             FlowRun[]
  events           FlowEvent[]
  links            FlowLink[]

  @@index([workspaceId])
  @@index([instagramAccountId, status])
}

/// One contact's pass through a flow.
model FlowRun {
  id             String        @id @default(cuid())
  flowId         String
  conversationId String
  status         FlowRunStatus @default(RUNNING)
  currentNodeId  String?
  /// What the run is parked on: FlowWaiting (see lib/flows/types.ts).
  waiting        Json?
  retries        Int           @default(0)
  /// Trigger context: { trigger, commentId?, automationId?, keyword?, ref? }.
  context        Json          @default("{}")
  /// Number of messages sent by this run (private reply counts as one).
  sends          Int           @default(0)
  lastError      String?
  startedAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  flow         Flow           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversation DmConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events       FlowEvent[]

  @@index([conversationId, status])
  @@index([flowId, status])
}

/// Per-step analytics (sent, clicked, input captured, ...).
model FlowEvent {
  id             String        @id @default(cuid())
  flowId         String
  runId          String?
  nodeId         String
  conversationId String?
  type           FlowEventType
  detail         Json?
  createdAt      DateTime      @default(now())

  flow Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  run  FlowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([flowId, nodeId, type])
  @@index([runId])
  @@index([createdAt])
}

/// Tracked redirect for a URL button inside a flow (/f/<slug>).
model FlowLink {
  id        String   @id @default(cuid())
  slug      String   @unique
  flowId    String
  nodeId    String
  buttonId  String
  url       String
  createdAt DateTime @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, nodeId, buttonId])
}

/// Uploaded image/video/audio/PDF used by flow steps. Served publicly at
/// /api/media/<id>/<filename> so Meta can fetch it when sending.
model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  kind        MediaKind
  filename    String
  mimeType    String
  size        Int
  /// Path relative to MEDIA_DIR.
  storageKey  String
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum FlowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum FlowRunStatus {
  /// Executing steps right now.
  RUNNING
  /// Parked on user input, a button tap, a delay, or the first reply.
  WAITING
  COMPLETED
  FAILED
  CANCELLED
  /// The 24h window closed, or an input/button wait timed out.
  EXPIRED
}

